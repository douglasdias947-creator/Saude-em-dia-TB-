name: Gerar APK - Saúde em Dia

on:
  workflow_dispatch:
  push:
    paths:
      - 'SaudeEmDia-Android.zip'
      - '.github/workflows/build-apk.yml'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar arquivos do repositório
        uses: actions/checkout@v4

      - name: Configurar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Extrair projeto Android
        run: |
          unzip -q SaudeEmDia-Android.zip -d extracted

      - name: Configurar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Compilar APK
        working-directory: extracted/SaudeEmDia
        run: gradle assembleDebug --stacktrace

      - name: Publicar APK para download
        uses: actions/upload-artifact@v4
        with:
          name: SaudeEmDia-APK
          path: extracted/SaudeEmDia/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 30
